# ==============================================================================
# AI SOFTWARE INCIDENT RESPONSE AGENT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
APP_NAME="AI Software Incident Response Agent"
APP_ENV="development"
DEBUG=false
LOG_LEVEL="INFO"
API_V1_STR="/api"

# Database Configuration (PostgreSQL in Docker / SQLite locally)
# For local SQLite: sqlite:///./incident_response.db
# For Docker PostgreSQL: postgresql://postgres:postgres@postgres:5432/incident_db
DATABASE_URL="sqlite:///./incident_response.db"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379/0"

# LLM Provider Configuration ("mock", "openrouter", "ollama")
LLM_PROVIDER="mock"

# OpenRouter (Optional when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="anthropic/claude-3.5-sonnet"

# Ollama (Optional when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

# LLM request resilience
# Free tiers rate-limit aggressively, and the autonomous pipeline treats a failed
# investigation as non-fatal, so an unretried 429 leaves an incident without an RCA.
# The token budget must also clear the reasoning tokens a reasoning model spends
# internally before emitting JSON (a 4096 cap truncates the RCA object).
LLM_MAX_TOKENS=16000
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BASE_DELAY_SECONDS=1.0
LLM_RETRY_MAX_DELAY_SECONDS=20.0

# Autonomous Closed-Loop Pipeline
# Sentinel always detects. These control whether the stages after it run without a
# human calling POST /incidents/{id}/investigate. Execution always requires approval.
AUTO_INVESTIGATE_ON_INCIDENT=true
AUTO_INVESTIGATE_SEVERITIES=["HIGH","CRITICAL"]
AUTO_PROPOSE_REMEDIATION=true
AUTO_RESPONSE_TIMEOUT_SECONDS=120.0

# GitHub Integration & Webhooks (Optional)
GITHUB_TOKEN=""
GITHUB_WEBHOOK_SECRET=""

# Robin Review / CodeGuard Integration (Optional)
ROBIN_REVIEW_URL=""
ROBIN_REVIEW_API_KEY=""

# Anomaly Detection & Incident Thresholds
HTTP_500_ERROR_THRESHOLD=5
HTTP_500_WINDOW_SECONDS=60
ERROR_RATE_THRESHOLD_PERCENT=20.0
DEPLOYMENT_ANOMALY_WINDOW_SECONDS=600
HEALTH_CHECK_FAILURE_CONSECUTIVE=2
